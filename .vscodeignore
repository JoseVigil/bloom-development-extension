# Carpetas que NO van en el VSIX
brain/**
build/**
builds/**
codebase/**
commits/**
config/**
contracts/**
dist/**
docs/**
installer/**
prompts/**
scripts/**
src/**
tasks/**
tree/**
webview/**
.cache/**
.vscode/**
.vscode-test/**
agentic-harness/**
.claude/**
BloomNucleus/**
accounts/**
tests/**

# Archivos sueltos que no van
*.py
*.ps1
*.sh
*.log
*.out
*.txt
*.mjs
.DS_Store
brain.config.json
build_number.txt
build-all-help.txt
tsconfig.json
eslint.config.mjs
setup.py
included-files.txt

# Incluir solo el bundle del installer
!installer/native/bin/bootstrap/bundle.js

# node_modules: excluir todo excepto runtime
node_modules/**
!node_modules/@vscode/codicons/**
!node_modules/ws/**
!node_modules/uuid/**
!node_modules/simple-git/**
!node_modules/fs-extra/**
!node_modules/graceful-fs/**
!node_modules/marked/**
!node_modules/marked-gfm-heading-id/**
!node_modules/@octokit/**
!node_modules/@google/**
!node_modules/punycode/**
!node_modules/unzipper/**
!node_modules/module-alias/**
!node_modules/tsconfig-paths/**
!node_modules/fastify/**
# @fastify/**: NO se puede usar una negación amplia acá — vsce no permite
# re-excluir subrutas dentro de un árbol ya negado con "!x/**" (ver más abajo
# el intento fallido con node_modules/@fastify/static/test/**). Por eso cada
# subpaquete se negocia por separado, y @fastify/static queda acotado a
# exactamente los archivos que necesita en runtime (nunca incluye test/).
!node_modules/@fastify/accept-negotiator/**
!node_modules/@fastify/ajv-compiler/**
!node_modules/@fastify/cors/**
!node_modules/@fastify/error/**
!node_modules/@fastify/fast-json-stringify-compiler/**
!node_modules/@fastify/forwarded/**
!node_modules/@fastify/merge-json-schemas/**
!node_modules/@fastify/proxy-addr/**
!node_modules/@fastify/send/**
!node_modules/@fastify/swagger/**
!node_modules/@fastify/swagger-ui/**
!node_modules/@fastify/static/package.json
!node_modules/@fastify/static/index.js
!node_modules/@fastify/static/lib/**
!node_modules/@fastify/static/node_modules/**
!node_modules/find-my-way/**
!node_modules/light-my-request/**
!node_modules/pino/**
!node_modules/pino-std-serializers/**
!node_modules/sonic-boom/**
!node_modules/on-exit-leak-free/**
!node_modules/thread-stream/**
!node_modules/atomic-sleep/**
!node_modules/quick-format-unescaped/**
!node_modules/real-require/**
!node_modules/safe-stable-stringify/**
!node_modules/secure-json-parse/**
!node_modules/semver/**
!node_modules/avvio/**
!node_modules/fastq/**
!node_modules/reusify/**
!node_modules/leven/**
!node_modules/process-warning/**
!node_modules/proxy-addr/**
!node_modules/ipaddr.js/**
!node_modules/rfdc/**
!node_modules/abstract-logging/**
!node_modules/ajv/**
!node_modules/ajv-formats/**
!node_modules/fast-deep-equal/**
!node_modules/fast-uri/**
!node_modules/json-schema-traverse/**
!node_modules/uri-js/**
!node_modules/proper-lockfile/**
!node_modules/chokidar/**
!node_modules/retry/**
!node_modules/anymatch/**
!node_modules/braces/**
!node_modules/fill-range/**
!node_modules/glob-parent/**
!node_modules/is-binary-path/**
!node_modules/is-glob/**
!node_modules/is-extglob/**
!node_modules/normalize-path/**
!node_modules/readdirp/**
!node_modules/picomatch/**
!node_modules/to-regex-range/**
!node_modules/binary-extensions/**

# Dentro de los paquetes permitidos arriba: excluir test/docs/fixtures.
# Esto es lo que saca node_modules/@fastify/static/test/static-symbolic-link
# (el symlink que rompe el escaneo de secretos de vsce con EISDIR) y de paso
# reduce bastante el tamaño del VSIX.
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/*.test.js
node_modules/**/.github/**
node_modules/**/benchmark/**
node_modules/**/benchmarks/**
node_modules/**/example/**
node_modules/**/examples/**
node_modules/**/*.map
node_modules/**/*.ts

# Fix quirúrgico: excluir puntualmente el fixture con symlink que
# rompe el escáner de secretos de vsce con EISDIR, sin depender de
# que el bloque de arriba se haya aplicado correctamente.
node_modules/@fastify/static/test/**
