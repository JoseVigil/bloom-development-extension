{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognituum.execution/v1/execution-package",
  "title": "Cognituum Execution Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "objective", "prior_state", "constraints", "workspace_ref", "inputs", "acceptance_criteria", "capabilities", "policy_ref", "correlation_ids"],
  "properties": {
    "schema_version": { "const": "cognituum.execution/v1" },
    "package_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "prior_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_ref", "summary"],
      "properties": {
        "checkpoint_ref": { "type": ["string", "null"] },
        "summary": { "type": "string" }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "workspace_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "root_ref"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "root_ref": { "type": "string", "pattern": "^workspace://" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256"],
        "properties": {
          "ref": { "type": "string", "pattern": "^workspace://" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "policy_ref": { "type": "string", "pattern": "^grant://" },
    "correlation_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandate_id", "intent_id", "turn_id"],
      "properties": {
        "mandate_id": { "type": "string", "minLength": 1 },
        "intent_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
