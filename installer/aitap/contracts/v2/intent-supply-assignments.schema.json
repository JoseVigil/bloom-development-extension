{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bloom.intent-supply-assignments/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mandate_id", "prepared_contract_digest", "assignments", "validation"],
  "properties": {
    "schema_version": {"const": "bloom.intent-supply-assignments/v1"},
    "mandate_id": {"type": "string", "minLength": 1},
    "prepared_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignment"}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["fingerprint", "validated_at", "valid_until"], "properties": {"fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "validated_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}}}
  },
  "$defs": {
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "destination"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "destination": {"type": "object", "additionalProperties": false, "required": ["backend_id", "provider", "model"], "properties": {"backend_id": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}}},
        "limits": {"type": "object", "additionalProperties": false, "required": ["max_inferences", "max_output_tokens", "max_total_tokens"], "properties": {"max_inferences": {"type": "integer", "minimum": 1}, "max_output_tokens": {"type": "integer", "minimum": 1}, "max_total_tokens": {"type": "integer", "minimum": 1}, "max_usd": {"type": "string", "pattern": "^(0|0\\.[0-9]{1,6}|[1-9][0-9]*\\.[0-9]{1,6})$"}}}
      }
    }
  }
}
