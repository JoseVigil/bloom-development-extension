# synapse-runner environment configuration
# Copy to .env and adjust for your local BloomNucleus dev setup.

# --- Debug panel / EventBus (Capa 3) ---
SYNAPSE_EVENTBUS_WS_URL=ws://localhost:4124
SYNAPSE_DEBUG_PANEL_HTTP_URL=http://localhost:48215

# --- Native messaging host (background.js router) ---
SYNAPSE_NATIVE_HOST_PORT=5678

# --- brain CLI contingency (Capa 4 / paso 06-contingencia) ---
# Debe existir en PATH, o pasar ruta absoluta.
BRAIN_CLI_BIN=brain

# --- Companion / Gemini engine watchdog (Capa 2) ---
# 🔶 Punto abierto Sección 7 #2: valor exacto de ENGINE_RESPONSE_TIMEOUT_MS
# no confirmado todavía contra background-companion.js. Este valor es un
# techo de seguridad conservador — ver README "Puntos abiertos" antes de
# confiar en él para aserciones de timing finas.
ENGINE_RESPONSE_TIMEOUT_MS_FALLBACK=45000
RUNNER_WATCHDOG_SLACK_MS=5000

# --- Electron / Conductor ---
# Ruta al ejecutable de Conductor en modo desarrollo. Dejar vacío para
# que bloom-paths.ts intente resolverlo desde BloomNucleus/bin/conductor/.
CONDUCTOR_EXE_PATH=

# --- Override manual de BloomNucleus base_dir ---
# Normalmente NO hace falta: bloom-paths.ts replica la resolución de
# brain/shared/paths.py (XDG_DATA_HOME / ~/.local/share/BloomNucleus en
# Linux). Setear esto solo si tu entorno usa una ruta no estándar.
BLOOM_NUCLEUS_BASE_DIR_OVERRIDE=
