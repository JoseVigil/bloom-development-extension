# URL base del backend (Worker de Cloudflare). En desarrollo local, vacío
# alcanza porque vite.config.ts hace proxy de /v1 a localhost:8787.
VITE_API_BASE_URL=

# Modo simulado: Login + ABM funcionan enteramente en el frontend, sin
# pegarle a backend/ (esos endpoints no existen todavía — ver
# src/api/mock.ts). Default true porque hoy es la única forma de ver estas
# pantallas funcionando de punta a punta. Poner en false el día que
# backend/ exponga /v1/auth/* y /v1/organizations/:id/users* de verdad.
VITE_MOCK_AUTH=true
