{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bloom.ing-classification/v1"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "mandate_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "domain": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "new",
                  "existing"
                ]
              },
              "domain_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "status",
              "domain_id",
              "name",
              "score"
            ],
            "additionalProperties": false
          },
          "gene": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "new",
                  "extend"
                ]
              },
              "gene_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "status",
              "gene_id",
              "score"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "minProperties": 1
          }
        },
        "required": [
          "cluster_id",
          "files",
          "domain",
          "gene",
          "evidence"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "mandate_id",
    "turn_id",
    "input_digest",
    "clusters"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
