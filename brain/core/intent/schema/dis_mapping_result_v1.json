{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bloom.dis-mapping/v1"
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "mandate_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "ing_result_ref": {
      "type": "string",
      "minLength": 1
    },
    "ing_result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "graph_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "create_domain",
              "rename_domain",
              "add_edge",
              "remove_edge",
              "merge_domains",
              "split_domains"
            ]
          },
          "proposal": {
            "type": "object"
          },
          "evidence": {
            "type": "object",
            "minProperties": 1
          },
          "human_decision": {
            "type": "null"
          },
          "override": {
            "type": "null"
          }
        },
        "required": [
          "operation_id",
          "type",
          "proposal",
          "evidence",
          "human_decision",
          "override"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "create_domain"
                }
              }
            },
            "then": {
              "properties": {
                "proposal": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gene_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "name",
                    "gene_ids"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "rename_domain"
                }
              }
            },
            "then": {
              "properties": {
                "proposal": {
                  "type": "object",
                  "properties": {
                    "domain_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "new_name": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "domain_id",
                    "new_name"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "add_edge"
                }
              }
            },
            "then": {
              "properties": {
                "proposal": {
                  "type": "object",
                  "properties": {
                    "domain_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gene_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "domain_id",
                    "gene_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remove_edge"
                }
              }
            },
            "then": {
              "properties": {
                "proposal": {
                  "type": "object",
                  "properties": {
                    "domain_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gene_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "domain_id",
                    "gene_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "merge_domains"
                }
              }
            },
            "then": {
              "properties": {
                "proposal": {
                  "type": "object",
                  "properties": {
                    "source_domain_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "minItems": 2
                    },
                    "target_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "object",
                      "minProperties": 1
                    }
                  },
                  "required": [
                    "source_domain_ids",
                    "target_name",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "split_domains"
                }
              }
            },
            "then": {
              "properties": {
                "proposal": {
                  "type": "object",
                  "properties": {
                    "source_domain_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "targets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "gene_ids": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true,
                            "minItems": 1
                          }
                        },
                        "required": [
                          "name",
                          "gene_ids"
                        ],
                        "additionalProperties": false
                      },
                      "uniqueItems": true,
                      "minItems": 2
                    }
                  },
                  "required": [
                    "source_domain_id",
                    "targets"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "mandate_id",
    "turn_id",
    "ing_result_ref",
    "ing_result_digest",
    "graph_snapshot_digest",
    "operations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
