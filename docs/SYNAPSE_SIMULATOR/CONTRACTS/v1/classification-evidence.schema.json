{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloom.local/synapse-simulator/v1/classification-evidence.schema.json",
  "title": "ClassificationEvidence 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain_baseline", "objective", "candidate_clusters"],
  "properties": {
    "domain_baseline": { "enum": ["empty", "existing"] },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": { "instructions": { "type": "string", "minLength": 1, "maxLength": 8192 } }
    },
    "candidate_clusters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/candidateCluster" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "summary", "symbols", "imports"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "summary": { "type": "string", "maxLength": 32768 },
        "symbols": { "type": "array", "maxItems": 10000, "items": { "type": "string", "maxLength": 1024 } },
        "imports": { "type": "array", "maxItems": 10000, "items": { "type": "string", "maxLength": 4096 } }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "score"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "score": { "$ref": "#/$defs/score" }
      }
    },
    "candidateCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_cluster_id", "files", "structural_relations", "semantic_scores", "candidate_domains", "candidate_genes"],
      "properties": {
        "candidate_cluster_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "files": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/fileEvidence" } },
        "structural_relations": { "type": "array", "maxItems": 50000, "items": { "type": "object" } },
        "semantic_scores": { "type": "array", "maxItems": 50000, "items": { "type": "object" } },
        "candidate_domains": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/candidate" } },
        "candidate_genes": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/candidate" } }
      }
    }
  }
}
