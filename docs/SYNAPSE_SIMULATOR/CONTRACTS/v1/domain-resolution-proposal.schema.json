{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloom.local/synapse-simulator/v1/domain-resolution-proposal.schema.json",
  "title": "DomainResolutionProposal 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters", "unresolved_files", "questions"],
  "properties": {
    "clusters": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/resolvedCluster" } },
    "unresolved_files": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/relativePath" } },
    "questions": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 8192 } }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "newOrExisting": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "domain_id", "name"],
          "properties": { "status": { "const": "new" }, "domain_id": { "type": "null" }, "name": { "type": "string", "minLength": 1, "maxLength": 512 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "domain_id", "name"],
          "properties": { "status": { "const": "existing" }, "domain_id": { "type": "string", "minLength": 1, "maxLength": 256 }, "name": { "type": "string", "minLength": 1, "maxLength": 512 } }
        }
      ]
    },
    "gene": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "gene_id", "name", "files"],
          "properties": { "status": { "const": "new" }, "gene_id": { "type": "null" }, "name": { "type": "string", "minLength": 1, "maxLength": 512 }, "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "gene_id", "name", "files"],
          "properties": { "status": { "const": "extend" }, "gene_id": { "type": "string", "minLength": 1, "maxLength": 256 }, "name": { "type": "string", "minLength": 1, "maxLength": 512 }, "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } } }
        }
      ]
    },
    "resolvedCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "source_candidate_ids", "files", "domain", "genes", "confidence", "rationale"],
      "properties": {
        "cluster_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_candidate_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "domain": { "$ref": "#/$defs/newOrExisting" },
        "genes": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/gene" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    }
  }
}
