{
  "version": "fg-es-v1",
  "language": "es",
  "note": "Prueba MULTILINGÜE separada: mismas herramientas (descripciones en inglés), pedidos en español rioplatense. No mezclar con los resultados en inglés.",
  "tools": [
    {"type": "function", "function": {"name": "find_project", "description": "Find a project by its exact name",
      "parameters": {"type": "object", "properties": {"name": {"type": "string", "description": "Exact project name"}}, "required": ["name"]}}},
    {"type": "function", "function": {"name": "find_person", "description": "Find a team member by their full name",
      "parameters": {"type": "object", "properties": {"name": {"type": "string", "description": "Person's full name"}}, "required": ["name"]}}},
    {"type": "function", "function": {"name": "list_tasks", "description": "List tasks of a project filtered by status",
      "parameters": {"type": "object", "properties": {
        "project": {"type": "string", "description": "Exact project name"},
        "status": {"type": "string", "enum": ["open", "done", "all"], "description": "Task status filter"}}, "required": ["project", "status"]}}},
    {"type": "function", "function": {"name": "create_note", "description": "Attach a text note to a project",
      "parameters": {"type": "object", "properties": {
        "project": {"type": "string", "description": "Exact project name"},
        "text": {"type": "string", "description": "Note text"}}, "required": ["project", "text"]}}},
    {"type": "function", "function": {"name": "set_reminder", "description": "Set a reminder for the user after a number of minutes",
      "parameters": {"type": "object", "properties": {
        "text": {"type": "string", "description": "What to remind"},
        "minutes": {"type": "integer", "description": "Minutes from now"}}, "required": ["text", "minutes"]}}}
  ],
  "cases": [
    {"id": "es01_exact_project", "category": "exact", "prompt": "Buscá el proyecto llamado Aurora",
     "expected": {"tool": "find_project", "args": {"name": "Aurora"}}},
    {"id": "es02_similar_person", "category": "similar_name", "prompt": "Buscá a Aurora Díaz en el equipo",
     "expected": {"tool": "find_person", "args": {"name": "Aurora Díaz"}, "match": {"name": "norm"}}},
    {"id": "es03_tasks_open", "category": "args", "prompt": "Mostrame las tareas abiertas del proyecto Aurora",
     "expected": {"tool": "list_tasks", "args": {"project": "Aurora", "status": "open"}}},
    {"id": "es04_tasks_done", "category": "args", "prompt": "Listá las tareas terminadas de Nimbus",
     "expected": {"tool": "list_tasks", "args": {"project": "Nimbus", "status": "done"}}},
    {"id": "es05_note", "category": "args", "prompt": "Agregá una nota al proyecto Aurora que diga: presupuesto aprobado",
     "expected": {"tool": "create_note", "args": {"project": "Aurora", "text": "presupuesto aprobado"}, "match": {"text": "norm"}}},
    {"id": "es06_reminder", "category": "args", "prompt": "Recordame en 15 minutos llamar a Ana",
     "expected": {"tool": "set_reminder", "args": {"text": "llamar a Ana", "minutes": 15}, "match": {"text": "norm", "minutes": "int"}}},
    {"id": "es07_not_offered_delete", "category": "not_offered", "prompt": "Borrá el proyecto Aurora",
     "expected": {"abstain": true}},
    {"id": "es08_not_offered_weather", "category": "not_offered", "prompt": "¿Cómo está el clima hoy en Buenos Aires?",
     "expected": {"abstain": true}},
    {"id": "es09_chitchat", "category": "chitchat", "prompt": "Gracias, por ahora es todo",
     "expected": {"abstain": true}},
    {"id": "es10_missing_arg", "category": "ambiguous", "prompt": "Mostrame las tareas",
     "expected": {"abstain": true}}
  ]
}
